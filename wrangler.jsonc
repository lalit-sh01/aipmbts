// Cloudflare Workers config: serves the built static site from dist/.
// The site answers on lalitshewani.com and www.lalitshewani.com (Workers custom domains,
// created on deploy because the domain's zone is in the same Cloudflare account).
{
  "name": "aipmbts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "lalitshewani.com", "custom_domain": true },
    { "pattern": "www.lalitshewani.com", "custom_domain": true }
  ]
}
