---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Climb from '../../components/lab/Climb.astro';
import LabBar from '../../components/lab/LabBar.astro';
import { site } from '../../data/site';
import '../../styles/lab.css';
// Logic: 1) Who is this?  -> intro + face, side by side (face looks left, into the words)
//        2) How did he get here? -> the climb, full width; "now" lands under the photo
//        3) What next? -> actions in the corner under "now"; "8+ years" in the corner before 2018
---
<Base title="Lab B · Bento">
  <div class="wrap lab-sec">
    <LabBar current="b" />
    <SectionHead id="about" side="none">A bit about me</SectionHead>
    <div class="b3">
      <div class="tile b3-who glow-warm">
        <div class="b3-text">
          <p class="t-lead"><span class="acc-day">I'm Lalit.</span> I work on AI products at Ford, and spent the eight years before that at JP Morgan Chase.</p>
          <p class="t-body">Today that means document intelligence, an audit agent that keeps a person in charge, and AI tools for teams outside engineering. At the bank I went from writing trade-processing code to leading data and machine learning products, and helped run the Bengaluru PM community events.</p>
        </div>
        <img class="b3-face" src="/img/lalit-960.webp" alt="Lalit Shewani, arms folded, looking to the side" width="960" height="960" />
      </div>
      <div class="tile b3-path">
        <p class="t-years"><b>8+</b><span>years across product and engineering</span></p>
        <Climb class="rv" />
        <div class="b3-next">
          <a class="act-row primary" href={site.resume} download>Download resume <span aria-hidden="true">↓</span></a>
          <div class="b3-next-row">
            <a class="act-row" href={site.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
            <a class="act-row" href="/about/">Full story <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>
