---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Climb from '../../components/lab/Climb.astro';
import LabBar from '../../components/lab/LabBar.astro';
import { site } from '../../data/site';
import '../../styles/lab.css';
---
<Base title="Lab C · Cinematic">
  <div class="wrap" style="padding-top:var(--space-12)"><LabBar current="c" /></div>
  <section class="cine" aria-labelledby="about">
    <figure class="cine-figure">
      <img src="/img/lalit-cut-1100.webp" srcset="/img/lalit-cut-560.webp 560w, /img/lalit-cut-1100.webp 1100w" sizes="(min-width:1000px) 50vw, 86vw" alt="Lalit Shewani, arms folded, looking to the side" width="1100" height="1183" />
    </figure>
    <div class="wrap cine-inner">
      <SectionHead id="about" side="none">A bit about me</SectionHead>
      <div class="cine-text">
        <p class="cine-lead"><span class="acc-day">I'm Lalit.</span> I work on AI products at Ford, and spent the eight years before that at JP Morgan Chase.</p>
        <p class="cine-body">Today that means document intelligence, an audit agent that keeps a person in charge, and AI tools for teams outside engineering. At the bank I went from writing trade-processing code to leading data and machine learning products, and helped run the Bengaluru PM community events.</p>
        <div class="about-cta"><a class="btn" href={site.resume} download>Download resume</a><a class="btn" href={site.linkedin}>LinkedIn</a><a class="btn" href="/about/">Full story</a></div>
      </div>
      <Climb class="rv" />
    </div>
  </section>
</Base>
