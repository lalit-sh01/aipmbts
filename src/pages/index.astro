---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Lessons from '../components/Lessons.astro';
import TechPosts from '../components/TechPosts.astro';
import Builds from '../components/Builds.astro';
import AboutMe from '../components/AboutMe.astro';
import Subscribe from '../components/Subscribe.astro';
import Stage from '../components/Stage.astro';
import { render } from '../lib/iflow.mjs';
import { site } from '../data/site';

const depth = render('Depth', { drift: true, intensity: 1 });
const flow = render('SignatureFlow', { animate: true, fit: 'cover', seed: 7 });
---
<Base>
  <section class="if-field if-field-drift if-hero if-hero-center hero" aria-labelledby="hero-h">
    <Fragment set:html={depth} />
    <div class="hero-fade" aria-hidden="true"></div>
    <div class="if-hero-flow hero-flow" aria-hidden="true" set:html={flow} />
    <div class="if-hero-copy hero-copy">
      <div class="hero-in-static">
        <h1 class="display if-heading if-upper hero-h" id="hero-h">
          <span>Product manager by <span class="acc-day">day.</span></span>
          <span>Builder by <span class="acc-night">night.</span></span>
        </h1>
      </div>
      <p class="if-fade-in if-hero-lead hero-lead hero-in" style="animation-delay:120ms">
        My notes on how AI products really get built, from the technology to the people who lead and use them.
      </p>
      <div class="if-fade-in hero-cta hero-in" style="animation-delay:240ms">
        <a class="btn btn-primary" href="#lessons">Start reading</a>
      </div>
    </div>
  </section>

  <Stage />
  <nav class="sec-index" aria-label="On this page">
    <span class="si-track" aria-hidden="true"><span class="si-fill"></span></span>
    <a href="#lessons" data-for="lessons"><span class="side-dot warm" aria-hidden="true"></span><span>Lessons</span></a>
    <a href="#tech" data-for="tech"><span class="side-dot cool" aria-hidden="true"></span><span>Tech</span></a>
    <a href="#builds" data-for="builds"><span class="side-dot cool" aria-hidden="true"></span><span>Builds</span></a>
    <a href="#about" data-for="about"><span class="side-dot both" aria-hidden="true"></span><span>About</span></a>
  </nav>
  <div class="scenes">
    <section class="scene" id="lessons" data-tint="warm">
      <SectionHead side="warm">Product lessons</SectionHead>
      <Lessons />
      <p class="ask">Stuck on something that isn't here? <a href={`mailto:${site.email}?subject=A%20lesson%20idea`}>Tell me about it</a>. It may become the next lesson.</p>
    </section>

    <section class="scene" id="tech" data-tint="net">
      <SectionHead side="cool">How the tech really works</SectionHead>
      <TechPosts />
    </section>

    <section class="scene" id="builds" data-tint="grid">
      <SectionHead side="cool">Late-night builds</SectionHead>
      <Builds />
    </section>

    <section class="scene" id="about" data-tint="core">
      <SectionHead side="both">A bit about me</SectionHead>
      <AboutMe />
    </section>

    <div class="scene-end"><Subscribe /></div>
  </div>
</Base>
