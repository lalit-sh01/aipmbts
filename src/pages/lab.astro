---
import Base from '../layouts/Base.astro';
import { render } from '../lib/iflow.mjs';
import { lab } from '../data/lab';
const glyph = render('FlowGlyph', { kind: 'diverge', width: 220, height: 56 });
---
<Base title="Lab" description="Things Lalit Shewani builds outside work: agent workflows, retrieval and AI that runs locally.">
  <div class="wrap page">
    <header class="page-head">
      <p class="if-eyebrow if-tone-cool">By night</p>
      <h1 class="h1">Lab</h1>
      <p class="lead">Things I build outside work, from agent workflows to AI that runs on your own laptop.</p>
    </header>
    <div class="lab-grid">
      {lab.map((l) => (
        <article class="if-card lab-card">
          <p class="if-eyebrow if-tone-cool">
            {l.tags.map((t, i) => (<>{i > 0 && <span class="if-eyebrow-sep" aria-hidden="true">·</span>}<span>{t}</span></>))}
          </p>
          <div class="lab-glyph" aria-hidden="true" set:html={glyph} />
          <h2 class="work-h">{l.name}</h2>
          <p class="lab-sum">{l.summary}</p>
          <p class="lab-detail">{l.detail}</p>
          {l.link && <a class="link-go meta" href={l.link}>See the code <span aria-hidden="true">→</span></a>}
        </article>
      ))}
    </div>
  </div>
</Base>
