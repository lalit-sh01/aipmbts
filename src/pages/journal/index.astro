---
import Base from '../../layouts/Base.astro';
import Subscribe from '../../components/Subscribe.astro';
import { entries } from '../../data/entries';
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Journal" description="Notes from inside AI product work, written up as cases other product managers can use.">
  <div class="wrap page">
    <header class="page-head">
      <p class="if-eyebrow if-tone-warm">By day</p>
      <h1 class="h1">Journal</h1>
      <p class="lead">Notes from inside AI product work, written up as cases other product managers can use.</p>
    </header>

    {entries.length ? (
      <ol class="entries">
        {entries.map((e, i) => (
          <li>
            <a class="if-card entry" href={`/journal/${e.slug}/`}>
              <p class="if-eyebrow if-tone-mist">
                <span>Entry {String(entries.length - i).padStart(3, '0')}</span>
                <span class="if-eyebrow-sep" aria-hidden="true">·</span><span>{fmt(e.date)}</span>
                {e.series && (<><span class="if-eyebrow-sep" aria-hidden="true">·</span><span>{e.series}</span></>)}
              </p>
              <h2 class="work-h">{e.title}</h2>
              <p class="lab-sum">{e.summary}</p>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <div class="if-card empty">
        <p class="if-eyebrow if-tone-mist">Entry 001</p>
        <p class="lab-sum">The first entries go up shortly after launch. Subscribe below and they will come to your inbox.</p>
      </div>
    )}

    <div class="block"><Subscribe /></div>
  </div>
</Base>
