---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="wrap page">
    <header class="page-head">
      <p class="if-eyebrow if-tone-mist">404</p>
      <h1 class="h1">This page isn’t here</h1>
      <p class="lead">The link may be old. The <a href="/">home page</a> has everything else.</p>
    </header>
  </div>
</Base>
