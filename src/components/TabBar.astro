---
// Phone-only bottom tab bar, so the site feels like an app on small screens.
const path = Astro.url.pathname;
const home = path === '/';
const tabs = [
  { id: 'lessons', label: 'Lessons', page: '/lessons/', icon: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"/>' },
  { id: 'tech', label: 'Tech', page: '/tech/', icon: '<rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 9h6v6H9zM9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>' },
  { id: 'builds', label: 'Builds', page: '/builds/', icon: '<path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"/>' },
  { id: 'about', label: 'About', page: '/about/', icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>' },
];
---
<nav class="tabbar" aria-label="Sections">
  {tabs.map((t) => (
    <a href={home ? `#${t.id}` : t.page} data-section={home ? t.id : undefined} data-active={!home && path.startsWith(t.page) ? '' : undefined} aria-current={!home && path.startsWith(t.page) ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon} />
      <span>{t.label}</span>
    </a>
  ))}
</nav>
