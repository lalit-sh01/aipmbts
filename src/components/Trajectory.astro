---
import { site } from '../data/site';
// Career trajectory as a staircase: each role is a step up, drawn step by step when it comes into view
// (motion.ts, section 6). Titles are exactly as on the resume (Sep 2026); only the line breaks are ours.
// The only pulsing point is "now". Colours are tokens, so the Paper theme works too.
const steps = [
  { year: '2018', title: ['Software Development', 'Engineer II'], org: 'JP Morgan Chase', color: 'var(--champagne)' },
  { year: '2021', title: ['Associate Technical Product', 'Manager, Data Platform'], org: 'JP Morgan Chase', color: 'color-mix(in oklab, var(--champagne) 55%, var(--converge-soft))' },
  { year: '2023', title: ['Technical Product', 'Manager (AVP)'], org: 'JP Morgan Chase', color: 'color-mix(in oklab, var(--converge-soft) 60%, var(--sky))' },
  { year: '2026 · now', title: ['Senior Product Manager', 'AI Advancement Center'], org: 'Ford', color: 'var(--electric-blue)' },
];
const label = 'Career: Software Development Engineer II at JP Morgan Chase from 2018; Associate Technical Product Manager, Data Platform, from 2021; Technical Product Manager (AVP) from 2023; Senior Product Manager, AI Advancement Center, at Ford from 2026.';

// Desktop: four treads rising left to right; the last tread runs into the portrait, so the climb ends at "now".
// Rise is kept shallow so the band reads as one line under the intro, not a tall diagram with a hole above it.
const tread = 236, gap = 26, rise = 64, x0 = 10, y0 = 316, r = 14;
const P = 220;                                   // portrait size, in viewBox units
const pts = steps.map((_, i) => ({ x: x0 + i * (tread + gap), y: y0 - i * rise }));
let d = `M ${pts[0].x} ${pts[0].y}`;
pts.forEach((p, i) => {
  const xEnd = p.x + tread;
  if (i < pts.length - 1) {
    const n = pts[i + 1], rx = xEnd + gap;
    d += ` H ${rx - r} Q ${rx} ${p.y} ${rx} ${p.y - r} V ${n.y + r} Q ${rx} ${n.y} ${rx + r} ${n.y}`;
  } else {
    d += ` H ${xEnd}`;
  }
});
const last = pts[pts.length - 1];
const joint = last.x + tread;                    // where the line meets the portrait
const px = joint + 22, py = last.y - P / 2;      // portrait centred on the last tread
const W = px + P + 2, H = y0 + 90;
const photo = site.photo;

// Phone: a compact staircase climbing upward, labels to the right of each tread.
const pt = 64, pr = 104, px0 = 12, py0 = 430;
const ppts = steps.map((_, i) => ({ x: px0 + i * 30, y: py0 - i * pr }));
let pd = `M ${ppts[0].x} ${ppts[0].y}`;
ppts.forEach((p, i) => {
  if (i < ppts.length - 1) {
    const n = ppts[i + 1];
    pd += ` H ${n.x - 10} Q ${n.x} ${p.y} ${n.x} ${p.y - 10} V ${n.y + 10} Q ${n.x} ${n.y} ${n.x + 10} ${n.y}`;
  } else {
    pd += ` H ${p.x + pt}`;
  }
});
const plast = ppts[ppts.length - 1];
---
<div class="me-path me-path-h">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
    <defs>
      <linearGradient id="stairGrad" gradientUnits="userSpaceOnUse" x1={x0} y1="0" x2={joint} y2="0">
        <stop offset="0" style="stop-color:var(--champagne)" />
        <stop offset="0.5" style="stop-color:var(--converge-soft)" />
        <stop offset="1" style="stop-color:var(--cyan-hot)" />
      </linearGradient>
      <clipPath id="stairPortrait"><rect x={px} y={py} width={P} height={P} rx="18" /></clipPath>
    </defs>
    <path d={d} fill="none" stroke="url(#stairGrad)" stroke-width="2" stroke-linecap="round" />
    {steps.map((s, i) => {
      const x = pts[i].x + (i ? 24 : 2), y = pts[i].y, isNow = i === steps.length - 1;
      return (
        <g class={isNow ? 'stair-now' : undefined}>
          {isNow && photo && <image href={photo} x={px} y={py} width={P} height={P} clip-path="url(#stairPortrait)" preserveAspectRatio="xMidYMid slice" />}
          {isNow && photo && <rect class="stair-frame" x={px} y={py} width={P} height={P} rx="18" />}
          {isNow && <circle class="now-ring" cx={joint} cy={last.y} r="14" style={`fill:${s.color}`} />}
          {isNow && <circle cx={joint} cy={last.y} r="5" style={`fill:${s.color}`} />}
          <text class="stair-year" x={x} y={y - 16}>{s.year}</text>
          <text class="stair-title" x={x} y={y + 30} style={`fill:${s.color}`}>
            <tspan x={x}>{s.title[0]}</tspan><tspan x={x} dy="22">{s.title[1]}</tspan>
          </text>
          <text class="stair-org" x={x} y={y + 78}>{s.org}</text>
        </g>
      );
    })}
  </svg>
</div>

<div class="me-path me-path-v">
  <svg viewBox="0 0 340 460" role="img" aria-label={label}>
    <defs>
      <linearGradient id="stairGradV" gradientUnits="userSpaceOnUse" x1="0" y1={py0} x2="0" y2={plast.y}>
        <stop offset="0" style="stop-color:var(--champagne)" />
        <stop offset="0.5" style="stop-color:var(--converge-soft)" />
        <stop offset="1" style="stop-color:var(--cyan-hot)" />
      </linearGradient>
    </defs>
    <path d={pd} fill="none" stroke="url(#stairGradV)" stroke-width="2" stroke-linecap="round" />
    {steps.map((s, i) => {
      const isNow = i === steps.length - 1;
      const x = ppts[i].x + (isNow ? 0 : 46), y = ppts[i].y;
      return (
        <g class={isNow ? 'stair-now' : undefined}>
          {isNow && <circle class="now-ring" cx={plast.x + pt} cy={plast.y} r="12" style={`fill:${s.color}`} />}
          {isNow && <circle cx={plast.x + pt} cy={plast.y} r="4.5" style={`fill:${s.color}`} />}
          <text class="stair-year" x={x} y={y - 72}>{s.year}</text>
          <text class="stair-title" x={x} y={y - 52} style={`fill:${s.color}`}>
            <tspan x={x}>{s.title[0]}</tspan><tspan x={x} dy="18">{s.title[1]}</tspan>
          </text>
          <text class="stair-org" x={x} y={y - 12}>{s.org}</text>
        </g>
      );
    })}
  </svg>
</div>
