---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-foot">
  <div class="wrap foot-inner">
    <p class="meta">
      <a href={`mailto:${site.email}`}>Email</a><span class="if-eyebrow-sep" aria-hidden="true">·</span>
      <a href={site.linkedin} rel="me">LinkedIn</a><span class="if-eyebrow-sep" aria-hidden="true">·</span>
      <a href={site.github} rel="me">GitHub</a><span class="if-eyebrow-sep" aria-hidden="true">·</span>
      <a href={site.resume}>Resume</a>
    </p>
    <p class="foot-note">© {year} Lalit Shewani · Bengaluru</p>
  </div>
</footer>
