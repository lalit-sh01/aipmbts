---
import { site } from '../data/site';
const action = site.buttondown ? `https://buttondown.com/api/emails/embed-subscribe/${site.buttondown}` : '';
---
<section class="subscribe if-card" id="subscribe" aria-label="Stay in touch">
  <p class="sub-line">If something here helped, I can send you the next one. One email when something new goes up, nothing else.</p>
  {action ? (
    <form class="sub-form" action={action} method="post" target="_blank" data-sub>
      <label class="sr-only" for="sub-email">Email address</label>
      <input id="sub-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
      <input type="hidden" name="embed" value="1" />
      <button type="submit" class="btn btn-primary">Subscribe</button>
    </form>
    <p class="sub-done" role="status" aria-live="polite" hidden><span class="side-dot both" aria-hidden="true"></span><span>Thank you. Please check your inbox to confirm.</span></p>
  ) : (
    <p class="sub-soon">Subscriptions open soon. Until then, <a href={site.linkedin}>LinkedIn</a> is the best place to follow along.</p>
  )}
</section>
<script is:inline>
  // Keep visitors on the site: send the sign-up to Buttondown in the background and confirm here.
  // If the background request fails, the form falls back to Buttondown's own page.
  document.querySelectorAll('form[data-sub]').forEach(function (f) {
    f.addEventListener('submit', function (e) {
      if (!window.fetch) return;
      e.preventDefault();
      var btn = f.querySelector('button'); btn.disabled = true; btn.textContent = 'Sending…';
      fetch(f.action, { method: 'POST', mode: 'no-cors', body: new FormData(f) })
        .then(function () { f.hidden = true; f.nextElementSibling.hidden = false; })
        .catch(function () { btn.disabled = false; btn.textContent = 'Subscribe'; f.removeAttribute('data-sub'); f.submit(); });
    });
  });
</script>
