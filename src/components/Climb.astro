---
// Career as a staircase built from real text, so it stays crisp at every width.
// Titles exactly as on the resume (Sep 2026). Colour runs warm (product) to cool (now).
// Desktop: four treads rising left to right. Phones: a vertical rail, newest at the top.
const steps = [
  { year: '2018', title: 'Software Development Engineer II', org: 'JP Morgan Chase', c: 'var(--champagne)' },
  { year: '2021', title: 'Associate Technical Product Manager, Data Platform', org: 'JP Morgan Chase', c: 'color-mix(in oklab, var(--champagne) 55%, var(--converge-soft))' },
  { year: '2023', title: 'Technical Product Manager (AVP)', org: 'JP Morgan Chase', c: 'color-mix(in oklab, var(--converge-soft) 60%, var(--sky))' },
  { year: '2026 · now', title: 'Senior Product Manager, AI Advancement Center', org: 'Ford', c: 'var(--electric-blue)' },
];
---
<ol class="climb" aria-label="Career, from 2018 to now">
  {steps.map((s, i) => {
    const now = i === steps.length - 1;
    return (
      <li class="climb-step" data-now={now ? '' : undefined} style={`--i:${i};--c:${s.c}`}>
        <span class="climb-year">{s.year}{now && <span class="climb-pulse" aria-hidden="true"></span>}</span>
        <span class="climb-title">{s.title}</span>
        <span class="climb-org">{s.org}</span>
      </li>
    );
  })}
</ol>
